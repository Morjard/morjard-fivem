    "morjard-heist": "hack minigame starts a heist (cooldowns, police alert)",
    "morjard-houserobbery": "lockpick starts a robbery (police alert)",
    "morjard-housing": "zone [E] prompt only",
    "morjard-impound": "zone [E] prompt only",
    "morjard-jail": "work UI only while jailed",
    "morjard-marinedealer": "zone [E] prompt only",
    "morjard-marriage": "proposal needs a second player",
    "morjard-mining": "minigame needs a mining node",
    "morjard-nightclub": "zone [E] prompt only",
    "morjard-pawnshop": "zone [E] prompt only",
    "morjard-scrapyard": "needs a vehicle at the scrap spot",
    "morjard-taxi": "`taxi` requests a real paid ride",
    "morjard-towing": "menu only inside a tow truck",
    "morjard-tuningshop": "needs a vehicle inside the shop",
    "morjard-vehiclekeys": "key fob needs a nearby vehicle",
    "morjard-helicam": "needs to be in a helicopter",
    "morjard-fightclub": "no NUI (leaderboard goes to chat)",
    "morjard-racing": "no NUI (leaderboard goes to chat)",
    "morjard-hunting": "no NUI",
    "morjard-territories": "no NUI",
    "morjard-alert": "no NUI focus (server broadcast)",
    "morjard_target": "needs an entity under the eye",
