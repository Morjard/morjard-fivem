{
  "_comment": "Test list for ~/bin/mj-smoketest. Only UIs that open without physical proximity. Default close = ESC (only if some NUI holds focus, so ESC never opens the pause menu) + SetNuiFocus(false,false) from morjard-connector. NUI focus is per-resource, so ESC handled by the plugin's own page is the real close path.",
  "_defaults": {
    "wait": 1.5,
    "close": [
      {"key": "Escape", "if_focused": true},
      {"sleep": 0.3},
      {"client_lua": "SetNuiFocus(false, false)"}
    ]
  },
  "tests": [
    {"name": "phone", "open": {"devcon": "phone"}},
    {"name": "inventory", "open": {"devcon": "morjardinv"}},
    {"name": "inv-stash", "open": {"devcon": "testinvstash"}, "requires": "admin (morjard-inventory-devtest)"},
    {"name": "inv-trunk", "open": {"devcon": "testinvtrunk"}, "requires": "admin (morjard-inventory-devtest)"},
    {"name": "inv-glovebox", "open": {"devcon": "testinvglove"}, "requires": "admin (morjard-inventory-devtest)"},
    {"name": "bank", "open": {"client_lua": "TriggerServerEvent('morjard-banking:server:openBank')"}},
    {"name": "atm", "open": {"client_lua": "TriggerServerEvent('morjard-banking:server:openATM')"}},
    {"name": "emote-wheel", "open": {"devcon": "+emotewheel"}, "close": [{"devcon": "-emotewheel"}, {"key": "Escape", "if_focused": true}]},
    {"name": "hud-settings", "open": {"devcon": "+morjard_hud_settings"}, "close": [{"devcon": "+morjard_hud_settings", "if_focused": true}]},
    {"name": "creditscore", "open": {"devcon": "creditscore"}},
    {"name": "crypto", "open": {"devcon": "crypto"}},
    {"name": "jobs-board", "open": {"devcon": "jobs"}},
    {"name": "multijob", "open": {"devcon": "multijob"}},
    {"name": "newspaper", "open": {"devcon": "news"}},
    {"name": "perfdash", "open": {"devcon": "perfdash"}, "requires": "admin (server may reply denied)"},
    {"name": "realestate", "open": {"devcon": "realestate"}},
    {"name": "gym-menu", "open": {"client_lua": "TriggerServerEvent('morjard-gym:server:getMenuData')"}},
    {"name": "diving-briefing", "open": {"client_lua": "TriggerServerEvent('morjard-diving:server:requestBriefing')"}, "requires": "not currently diving"},
    {"name": "drug-dashboard", "open": {"client_lua": "TriggerServerEvent('morjard-drugbusiness:server:getBusinessData')"}},
    {"name": "biography", "open": {"devcon": "biography"}},
    {"name": "weather-tablet", "open": {"client_lua": "TriggerServerEvent('morjard-weather:server:openUI')"}},
    {"name": "weather-admin", "open": {"devcon": "weathermenu"}, "requires": "admin"},
    {"name": "weather-widget", "open": {"devcon": "weatherwidget"}, "close": {"devcon": "weatherwidget"}, "expect_focus": false},
    {"name": "chat-input", "open": {"devcon": "+chatOpen"}, "close": [{"devcon": "-chatOpen"}, {"key": "Escape", "if_focused": true}]},
    {"name": "barbershop", "open": {"client_lua": "TriggerServerEvent('morjard-barbershop:server:open')"}, "wait": 2.5, "requires": "ESC must cancel and restore the baseline look"},
    {"name": "outfitbag", "open": {"devcon": "outfits"}, "requires": "Config.RequiredItem in inventory (server denies otherwise)"},
    {"name": "radio", "open": {"devcon": "morjard_radio_toggle"}, "close": [{"devcon": "morjard_radio_toggle", "if_focused": true}], "requires": "radio item"},
    {"name": "admin-panel", "open": {"devcon": "admin"}, "requires": "admin tier"},
    {"name": "mdt", "open": {"devcon": "mdtopen"}, "requires": "police job"},
    {"name": "dispatch", "open": {"devcon": "dispatch"}, "requires": "police/EMS on duty"},
    {"name": "bodycam-records", "open": {"client_lua": "TriggerServerEvent('morjard-bodycam:server:showrecordingUI')"}, "requires": "police job"},
    {"name": "bounty-board", "open": {"devcon": "bounty"}, "requires": "bounty hunter licence"}
  ],
  "_skipped": {
    "morjard-multicharacter": "never test (brand surface, would log out the character)",
    "morjard-spawn-selector": "never test (teleports / respawns the player)",
    "morjard-pausemenu": "opens only on the ESC game control (200); WmAgent key injection into game controls is unreliable",
    "morjard-scoreboard": "hold-key control only, no command/event",
    "morjard-lawyer": "NUI has no ESC handler (only a close button) - focus would stay stuck; add an Escape handler, then add `lawyer`",
    "morjard-paparazzi": "history panel (`ppzhistory`) has no ESC handler (closeHistory button only) - focus would stay stuck",
    "morjard-insurance": "opens client-side only inside the office zone ([E]); server:open just sends data",
    "morjard-pets": "shop opens in petshop zone; client drops shopData unless the zone opened it",
    "morjard-auctionhouse": "zone [E] prompt only",
    "morjard-businesses": "zone [E] prompt (storefront/counter) only",
    "morjard-casino": "opens at a placed table",
